{
  "expo": {
    "name": "Pharmatrix Customer",
    "slug": "pharmatrix-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "pharmatrix-customer",
    "splash": {
      "backgroundColor": "#FDFBF8",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pharmatrix.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pharmatrix uses your foreground location to detect and verify your business pickup address."
      }
    },
    "android": {
      "package": "com.pharmatrix.customer",
      "adaptiveIcon": {
        "backgroundColor": "#201E1C"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pharmatrix uses your foreground location to detect and verify your business pickup address."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0E7A60",
          "defaultChannel": "pickup_updates"
        }
      ]
    ]
  }
}

