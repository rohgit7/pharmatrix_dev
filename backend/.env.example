# ==============================================================================
# Pharmatrix Backend - Environment Configuration Template
# ==============================================================================

# Application Setup
APP_NAME=Pharmatrix
APP_ENV=production
DEBUG=False

# Database (PostgreSQL / Supabase Transaction Pooler)
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Auth and Storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Storage Buckets
SUPABASE_STORAGE_BUCKET=customer-documents
SUPABASE_PICKUP_PROOF_BUCKET=pickup-proofs
SUPABASE_DISPOSAL_CERTIFICATE_BUCKET=disposal-certificates

# Connection Pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS Origins (Comma-separated, no wildcards in production)
CORS_ORIGINS=https://admin.pharmatrix.com,https://facility.pharmatrix.com,https://app.pharmatrix.com

# Routing & Navigation Service (OSRM)
OSRM_BASE_URL=https://router.project-osrm.org

# SMTP Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM_EMAIL=notifications@pharmatrix.com
SMTP_FROM_NAME=Pharmatrix Notifications
SMTP_USE_TLS=True

# WhatsApp Meta Graph API (Optional Provider)
WHATSAPP_PROVIDER=META
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WABA_ID=your-whatsapp-business-account-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verification-token
WHATSAPP_APP_SECRET=your-app-secret

# Razorpay Online Payment Gateway (Live credentials required in production)
RAZORPAY_KEY_ID=rzp_live_your_live_key_id
RAZORPAY_KEY_SECRET=your_live_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret
RAZORPAY_CURRENCY=INR

