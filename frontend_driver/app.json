{
  "expo": {
    "name": "Pharmatrix Driver",
    "slug": "frontend-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "pharmatrix-driver",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pharmatrix.driver"
    },
    "android": {
      "package": "com.pharmatrix.driver",
      "usesCleartextTraffic": true,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#0E7A60",
          "defaultChannel": "pickup_updates"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pharmatrix Driver to access your camera to scan pickup consignment QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Pharmatrix Driver to access your location for route telemetry and arrival verification."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
